{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacitra.dev/protocol/patch-v1.schema.json",
  "title": "Tacitra semantic patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_hash", "operations"],
  "properties": {
    "schema_version": { "const": 1 },
    "base_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "target", "replacement"],
        "properties": {
          "op": { "enum": ["replace_function_body", "replace_expression"] },
          "target": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string" }
        }
      }
    }
  }
}

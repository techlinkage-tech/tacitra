{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacitra.dev/protocol/repair-context-v1.schema.json",
  "title": "Tacitra minimal AI repair context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "code", "op", "target", "expected", "actual", "values", "allowed", "hash", "retry"],
  "properties": {
    "v": {"const": 1},
    "code": {"type": "string", "pattern": "^A[0-9]{4}$"},
    "op": {"type": ["integer", "null"], "minimum": 0},
    "target": {"type": ["string", "null"]},
    "expected": {"type": ["string", "null"]},
    "actual": {"type": ["string", "null"]},
    "values": {"type": "array"},
    "allowed": {"const": ["body", "expr"]},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "retry": {"type": "boolean"}
  }
}

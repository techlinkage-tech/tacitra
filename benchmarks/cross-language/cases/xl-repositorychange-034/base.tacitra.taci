fn solve_034(value: Int, divisor: Int) -> Result[Int, String] {
  if divisor <= 1 {
    Err("zero")
  } else {
    Ok(value / divisor)
  }
}

fn consume(result: Result[Int, String]) -> Int {
  match result {
    Ok(value) => value,
    Err(message) => -1,
  }
}

fn main() -> Int {
  consume(solve_034(54, 1))
}

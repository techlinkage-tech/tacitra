fn unrelated_alpha(value: Int) -> Int {
  value * 2
}

fn unrelated_beta(value: Int) -> Int {
  value - 3
}

fn unrelated_gamma(enabled: Bool) -> Int {
  if enabled { 7 } else { 9 }
}

record PacketSp338 {
  value: Int,
  enabled: Bool,
}

fn solve_sp_338(packet: PacketSp338) -> Int {
  if packet.enabled { packet.value + 3 } else { packet.value }
}

fn main() -> Int {
  solve_sp_338(new PacketSp338 { value: 368, enabled: true })
}

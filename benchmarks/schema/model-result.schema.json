{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacitra.dev/benchmarks/model-result-v3.schema.json",
  "title": "Tacitra raw model benchmark result v3",
  "type": "object",
  "required": ["schema_version", "evidence", "measurement_mode", "run_id", "trial_id", "case_id", "category", "representation", "language", "surface", "pins", "persistent_instructions", "attempts", "metrics", "compile_at_1", "pass_at_1", "repair_rounds", "max_repair_rounds", "patch_size", "accepted", "wall_clock_time", "failure"],
  "properties": {
    "schema_version": {"const": 3},
    "evidence": {"const": "measured"},
    "measurement_mode": {"const": "model"},
    "run_id": {"type": "string"}, "trial_id": {"type": "string"},
    "case_id": {"type": "string"}, "category": {"type": "string"},
    "representation": {"type": "string"}, "language": {"type": "string"}, "surface": {"type": "string"},
    "pins": {"type": "object"},
    "persistent_instructions": {"type": "object", "required": ["text", "hash"], "additionalProperties": false, "properties": {"text": {"type": "string"}, "hash": {"type": "string"}}},
    "attempts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "metrics": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "reasoning_tokens", "repair_output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "repair_output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "compile_at_1": {"type": "boolean"}, "pass_at_1": {"type": "boolean"},
    "repair_rounds": {"type": "integer", "minimum": 0},
    "max_repair_rounds": {"type": "integer", "minimum": 0},
    "patch_size": {"type": ["integer", "null"], "minimum": 0},
    "accepted": {"type": "boolean"}, "wall_clock_time": {"type": "number", "minimum": 0},
    "failure": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}

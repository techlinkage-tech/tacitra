fn unrelated_alpha(value: Int) -> Int {
  value * 2
}

fn unrelated_beta(value: Int) -> Int {
  value - 3
}

fn unrelated_gamma(enabled: Bool) -> Int {
  if enabled { 7 } else { 9 }
}

record PacketSp138 {
  value: Int,
  enabled: Bool,
}

fn solve_sp_138(packet: PacketSp138) -> Int {
  if packet.enabled { packet.value + 3 } else { packet.value }
}

fn main() -> Int {
  solve_sp_138(new PacketSp138 { value: 168, enabled: true })
}
